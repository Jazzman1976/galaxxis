    "windowsAuthentication": false,
    "anonymousAuthentication": true,
    "iis": {
      "applicationUrl": "http://local.galaxxis.com",
      "sslPort": 0
    },
    "iisExpress": {
      "applicationUrl": "http://localhost:52888",
      "sslPort": 0
    }
  },
  "profiles": {
    "IIS Express": {
      "commandName": "IISExpress",
      "launchBrowser": true,
      "environmentVariables": {
