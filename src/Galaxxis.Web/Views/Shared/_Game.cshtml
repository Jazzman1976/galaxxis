@using Galaxxis.Persistence.Accounts
@*
    Layout of all game pages: background image, cockpit foreground and the green interface panel.
    Pages render the layer divs themselves (#layer-background may carry a scene class, e.g. layer-background-galaxy).
    Signed-in players additionally get the navigation in the top right corner.
*@
<!DOCTYPE html>
<html class="html html--game" lang="de">
    <head>
        <meta charset="utf-8">
        <title>Galaxxis - @ViewBag.Title</title>
        <meta name="description" content="@ViewBag.Description">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <link rel="icon" href="~/images/favicon.ico" type="image/x-icon">
        <link rel="stylesheet" href="~/styles/main.css" asp-append-version="true">
        @RenderSection("Styles", required: false)
    </head>
    <body>
        <div id="content">
            @RenderBody()

            @if (User.Identity?.IsAuthenticated == true)
            {
                <nav class="game-nav">
                    <span class="game-nav__user">@User.Identity.Name</span>
                    <a class="button-link" asp-controller="Start" asp-action="Index">Universen</a>
                    @if (User.IsInRole(AccountRoles.Admin))
                    {
                        <a class="button-link" asp-controller="Admin" asp-action="Index">Admin</a>
                    }
                    @* Logout changes state, so it is a POST with antiforgery token, not a link. *@
                    <form class="game-nav__form" method="post" asp-controller="Account" asp-action="Logout">
                        <button type="submit">Logout</button>
                    </form>
                </nav>
            }
        </div>
        <script src="~/scripts/perfect-scrollbar.js"></script>
        <script src="~/scripts/main.js" asp-append-version="true"></script>
        @RenderSection("Scripts", required: false)
    </body>
</html>
