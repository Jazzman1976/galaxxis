</div>

<div id="producing-panel" style="margin-bottom: 1rem;">
    <table>
        <tr>
            <th>Shipyard (Level: @thePlanet.PlanetShipyard)</th>
            <th colspan="2">Produce</th>
        </tr>
        
        <tr>
            <td>
                <table>
                    <tr><th colspan="2">Upgrade to next level</th></tr>
                    <tr><th>Ore</th><td>@shipyard.BuildCosts[0]</td></tr>
                    <tr><th>Mana</th><td>@shipyard.BuildCosts[1]</td></tr>
                    <tr><th>Crystal</th><td>@shipyard.BuildCosts[2]</td></tr>
                    <tr><th>Elementium</th><td>@shipyard.BuildCosts[3]</td></tr>
                    <tr><th>Ticks</th><td>@shipyard.BuildCosts[4]</td></tr>
                </table>
                <form asp-controller="Home" asp-action="BuildShipyard" method="post">
                    <input type="hidden" name="planetId" value="@thePlanet.PlanetId" />
                    <input type="submit" value="Build" @(!shipyard.CanBuild ? "disabled" : "") />
                </form>
            </td>

            <td>
                <table>
                    <tr><th colspan="2">Produce Explorer</th></tr>
                    <tr><th>Tools</th><td>225</td></tr>
                    <tr><th>Crystals</th><td>@(Model.User.IsOffensive() ? "225" : "450")</td></tr>
                    <tr><th>Antimatter</th><td>@(Model.User.IsOffensive() ? "450" : "225")</td></tr>
                    <tr><th>Elementium</th><td>75</td></tr>
                </table>
                <form asp-controller="Home" asp-action="ProduceShipExplorer" method="post">
                    <input type="hidden" name="planetId" value="@thePlanet.PlanetId" />
                    <input type="submit" value="Produce Explorer" />
                </form>
            </td>

            <td>
                <table>
                    <tr><th colspan="2">Produce Carrier</th></tr>
                    <tr><th>Tools</th><td>450</td></tr>
                    <tr><th>Crystals</th><td>@(Model.User.IsOffensive() ? "450" : "900")</td></tr>
                    <tr><th>Antimatter</th><td>@(Model.User.IsOffensive() ? "900" : "450")</td></tr>
                    <tr><th>Elementium</th><td>150</td></tr>
                </table>
                <form asp-controller="Home" asp-action="ProduceShipCarrier" method="post">
                    <input type="hidden" name="planetId" value="@thePlanet.PlanetId" />
                    <input type="submit" value="Produce Carrier" />
                </form>
            </td>
        </tr>
    </table>
</div>

<div id="fleet-panel" style="margin-bottom: 1rem;">
    <table>
        <tr>
            <th>Type</th>
            <th>Tactical</th>
            <th>Storage capacity</th>
        </tr>
        @foreach (Ship ship in planetShips)
        {
            <tr>
                <td>@ship.ShipType</td>
                <td>@ship.ShipTactical</td>
                <td>@ship.ShipStorageCapacity</td>
            </tr>
        }
    </table>
</div>

<div id="events-panel" style="margin-bottom: 1rem;">
    <table>
        <tr>
            <th>Event Tick</th>
            <th>Event Name</th>
        </tr>
        @foreach (Event @event in thePlanet.GetEvents())
        {
            <tr>
                <td>@(@event.EventTick)</td>
                <td>@(@event.EventName)</td>
                <td>@(@event.EventData)</td>
            </tr>
        }
    </table>
</div>

<div id="info-panel" style="margin-bottom: 1rem;">
    @Model.Info
</div>

<div id="system-panel" style="margin-bottom: 1rem;">
    <table>
        <tr>
            <th>Planet</th>
            <th>X Coord</th>
            <th>Y Coord</th>
            <th>Z Coord</th>
            <th>Distance</th>
            <th>Commands</th>
        </tr>

        @foreach (Planet aPlanet in theSystem.Planet)
        {
            <tr>
                <td>@aPlanet.PlanetName</td>
                <td>@aPlanet.PlanetCoordinateX</td>
                <td>@aPlanet.PlanetCoordinateY</td>
                <td>@aPlanet.PlanetCoordinateZ</td>
                <td>@(DistanceHelper.GetDistance(thePlanet, aPlanet))</td>
                <td>
                    <form asp-controller="Home" asp-action="Attack" method="post">
                        <input type="hidden" name="planetId" value="@thePlanet.PlanetId" />
                        <input type="hidden" name="userId" value="@Model.User.UserId" />
                        <input type="hidden" name="planetIdTarget" value="@aPlanet.PlanetId" />
                        <input type="submit" value="Attack" />
                    </form>
                </td>
            </tr>
        }
    </table>
</div>
