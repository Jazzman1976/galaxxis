{
  // General defaults of the web application. No secrets here: connection strings go into appsettings.Local.json
  // (see appsettings.Local.json.template in the repository root) or into environment variables.
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // The event processing engine runs inside the web application. Set Enabled to false on additional web instances
  // that should only serve players (see src/Galaxxis.Engine/README.md).
  "Engine": {
    "Enabled": true,
    "PollInterval": "00:00:01"
  },

  // Defaults of the "generate universe" form on the admin page. Name, seed, the three counts and the tick length can be
  // changed in the form; coordinate range, minimum distance and moon probabilities are only set here.
  "UniverseGeneration": {
    "TickLength": "00:00:01",
    "Map": {
      "GalaxyCount": 10,
      "StarSystemsPerGalaxy": 10,
      "PlanetsPerStarSystem": 10,
      "CoordinateRange": 10,
      "MinimumDistance": 2,
      "OneMoonProbability": 0.09,
      "TwoMoonsProbability": 0.01
    }
  }
}
