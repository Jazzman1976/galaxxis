
@{ 
    Layout = "_Layout";
    ViewBag.Title = "Home";
}

@model Galaxxis.Web.Models.Home.HomeViewModel 

<div>Game Ticks: @Model.User.Planet.First().PlanetSystem.SystemGalaxy.GalaxyUniverse.UniverseTicks</div>
<div style="margin-bottom: 1rem;">Time between Ticks: @Model.User.Planet.First().PlanetSystem.SystemGalaxy.GalaxyUniverse.UniverseTimePerTick</div>

<table style="margin-bottom: 1rem;">
    <tr>
        <th>UserId</th>
        <th>UserEmail</th>
        <th>UserFirstname</th>
        <th>UserLastname</th>
    </tr>

    @if (Model.User != null)
    {
    <tr>
        <td>@Model.User.UserId</td>
        <td>@Model.User.UserEmail</td>
        <td>@Model.User.UserFirstname</td>
        <td>@Model.User.UserLastname</td>
    </tr>
    }
</table>

@if(Model.User.Planet.Any())
{
    Galaxxis.Data.Models.Planet thePlanet = Model.User.Planet.First();

    <table style="margin-bottom: 1rem;">
        <tr>
            <th>PlanetId</th>
            <th>PlanetName</th>
            <th>PlanetFields</th>            
            <th>SystemName</th>
            <th>GalaxyName</th>
            <th>Moons</th>
        </tr>

        @foreach(var planet in Model.User.Planet)
        {
            <tr>
                <td>@planet.PlanetId</td>
                <td>@planet.PlanetName</td>
                <td>@planet.PlanetFields</td>
                <td>@planet.PlanetSystem?.SystemName</td>
                <td>@planet.PlanetSystem?.SystemGalaxy?.GalaxyName</td>
                <td>
                    @if (planet.Moon.Any())
                    {
                    <table>
                        <tr>
                            <th>MoonId</th>
                            <th>MoonName</th>
                            <th>MoonFields</th>
                        </tr>
                        @foreach(var moon in planet.Moon)
                        {
                            <tr>
                                <td>@moon.MoonId</td>
                                <td>@moon.MoonName</td>
                                <td>@moon.MoonFields</td>
                            </tr>
                        }
                    </table>
                    }
                </td>
            </tr>
        }
    </table>

    <table style="margin-bottom: 1rem;">
        <tr>
            <th>Ore</th>
            <th>Energy</th>            
            <th>Tools</th>
            <th>Mana</th>
            <th>Crystals</th>
            <th>Antimatter</th>
            <th>Elementium</th>
        </tr>
        <tr>
            <td>@thePlanet.PlanetOre</td>
            <td>@thePlanet.PlanetEnergy</td>
            <td>@thePlanet.PlanetTools</td>
            <td>@thePlanet.PlanetMana</td>
            <td>@thePlanet.PlanetCrystals</td>
            <td>@thePlanet.PlanetAntimatter</td>
            <td>@thePlanet.PlanetElementium</td>
        </tr>
    </table>
}
