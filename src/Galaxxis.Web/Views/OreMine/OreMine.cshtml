@using Galaxxis.Core.Classes.Buildings.Interfaces
@using Galaxxis.Core.Extensions.PlanetExtensions;
@using Galaxxis.Core.Classes.Buildings.RessourceBuildings;
@{
    Layout = "_Game";
    ViewBag.Title = "Ore Mine";
    string infoMessage = TempData["InfoMessage"] as string;
    OreMine oreMine = Model.Planet.GetOreMine(true);
}
@model OreMineViewModel;

<div id="layer-background"></div>
<div id="layer-foreground"></div>
<div id="layer-inferface-background"></div>
<div id="layer-interface">
    <header>
        @await Component.InvokeAsync("ResourceBar", new { planet = Model.Planet })

        <h1>Planet: @Model.Planet.PlanetName - Erzmine</h1>
        
        <p>Du betrachtest deine Erzmine.</p>

        @if (infoMessage != null)
        {
            <p class="message">@infoMessage</p>
        }

        <ul>
            <li>
                <!--back to system view -->
                <a asp-controller="planet"
                   asp-action="Index"
                   asp-route-id="@Model.Planet.PlanetId">
                   Zurück zum Planetarischen Kontrollzentrum
               </a>
            </li>
        </ul>
    </header>

    <main>
        <h2>Erzmine</h2>
        <table class="info-table">
            <tr><th>Ausbaustufe</th>        <td>@Model.Planet.PlanetOreMine</td></tr>            
            <tr><th>Auslastung</th>         <td>@(oreMine.Usage * 100)%</td></tr>
            <tr><th>Einkommen pro Tag</th>  <td>@System.Math.Floor(oreMine.IncomePerDay)</td></tr>
        </table>

        <h3>Kosten für den Ausbau auf die nächste Stufe</h3>
        <table class="info-table">
            <tr><th>Erz</th><td>@oreMine.BuildCosts[0]</td></tr>
            <tr><th>Mana</th><td>@oreMine.BuildCosts[1]</td></tr>
            <tr><th>Kristalle</th><td>@oreMine.BuildCosts[2]</td></tr>
            <tr><th>Elementium</th><td>@oreMine.BuildCosts[3]</td></tr>
            <tr><th>Ticks</th><td>@oreMine.BuildCosts[4]</td></tr>
        </table>

        @if (!oreMine.CanBuild)
        {
            <p class="message">Du kannst die Erzmine aktuell nicht weiter ausbauen.</p>
        }
        else 
        {
            <form 
                method="post" 
                asp-controller="oremine" 
                asp-action="BuildOreMine" 
                asp-route-id="@Model.Planet.PlanetId">
                <input type="hidden" name="planetId" value="@Model.Planet.PlanetId" />
                <button type="submit">
                    Erzmine auf Stufe @(Model.Planet.PlanetOreMine + 1) ausbauen
                </button>
            </form>
        }
    </main>
</div>
