// Template for the machine-specific settings of all Galaxxis hosts (web, engine, tools).
//
// How to use:
//   1. Copy this file to "appsettings.Local.json" in the same folder (repository root).
//   2. Fill in your values. The real file is git-ignored, so secrets never get committed.
//   3. Build. Every host copies appsettings.Local.json next to its executable automatically.
//
// Priority (later wins): appsettings.json of the host < appsettings.Local.json
//                        < environment variables < command line arguments.
// On Azure the same keys are set as App Service settings / connection strings instead of this file.
{
  "ConnectionStrings": {
    // Game world: universes, planets, players, events. Created by EF Core migrations.
    "Game": "Server=(localdb)\\MSSQLLocalDB;Database=GalaxxisGame;Trusted_Connection=True;TrustServerCertificate=True",

    // Login accounts (ASP.NET Core Identity). A separate database by design.
    "Accounts": "Server=(localdb)\\MSSQLLocalDB;Database=GalaxxisAccounts;Trusted_Connection=True;TrustServerCertificate=True"
  }
}
