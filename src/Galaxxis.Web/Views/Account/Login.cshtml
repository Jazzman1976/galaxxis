
@{ 
    Layout = "_Game";
    ViewBag.Title = "Login";
}

@model LoginViewModel

<div id="layer-background"></div>
<div id="layer-foreground"></div>
<div id="layer-inferface-background"></div>
<div id="layer-interface">
    <header>
        <h1>Login</h1>
        <div>@Html.Raw(ViewBag.Message)</div>
    </header>

    <main>
        <p>
            Bitte log dich mit deinem Benutzernamen und deinem Passwort ein.
        </p>
        <form id="form-login" asp-controller="Account" asp-action="Login" method="post">
            <label class="gx-form__label" asp-for="User">
                <span>Username:</span>
                <input class="gx-form__textbox" asp-for="User" />
            </label>
            <label class="gx-form__label" asp-for="Password">
                <span>Password:</span>
                <input class="gx-form__textbox" asp-for="Password" />
            </label>
            <input asp-for="ReturnUrl" type="hidden" />
            <span class="gx-form__label">
                <span></span>
                <input 
                    class="gx-form__textbox" 
                    type="submit" 
                    value="Login" 
                    style="margin-right: 0.5rem" />
                <button
                    class="gx-form__textbox"
                    type="button"
                    onclick='window.location.href = "/"'>
                    Zurück
                </button>
            </span>
        </form>
    </main>
</div>
