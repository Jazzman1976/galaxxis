     <table:table-cell table:style-name="Table1.A2" office:value-type="string">
      <text:p text:style-name="P40">usw.…</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table1.A2" office:value-type="string">
      <text:p text:style-name="P37">usw.…</text:p>
     </table:table-cell>
