@using Galaxxis.Web.Views.Admin

@{ 
    Layout = "_Layout";
    ViewBag.Title = "Admin";
}

@model AdminViewModel

@using (Html.BeginForm("Index", "Admin", FormMethod.Post)) {
    <div>
        @Html.RadioButtonFor(m => m.TickerStatus, "running", new { id = "rbStatusRunning" })
        @Html.Label("rbStatusRunning", "running")
        @Html.RadioButtonFor(m => m.TickerStatus, "stopped", new { id = "rbStatusStopped" })
        @Html.Label("rbStatusStopped","stopped")
    </div>

    <input type="submit" value="Submit" />
}
