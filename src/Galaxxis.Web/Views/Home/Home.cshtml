            <td>@thePlanet.PlanetPowerSupplyUsage</td>
            <td>@thePlanet.PlanetFactoryUsage</td>
            <td>@thePlanet.PlanetMageAcademyUsage</td>
            <td>@thePlanet.PlanetCrystalMineUsage</td>
            <td>@thePlanet.PlanetNeutronAcceleratorUsage</td>
