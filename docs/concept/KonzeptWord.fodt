     <text:p text:style-name="P22"><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc2551_2106011183" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:soft-page-break/>6       Wachstumsraten<text:tab/>6</text:a></text:p>
     <text:p text:style-name="P23"><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc2553_2106011183" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">6.1       Wachstumsfaktor Rohstoffe<text:tab/>7</text:a></text:p>
     <text:p text:style-name="P23"><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc2555_2106011183" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">6.2       Wachstumsfaktor Versorgung<text:tab/>7</text:a></text:p>
     <text:p text:style-name="P23"><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc2557_2106011183" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">6.3       Wachstumsfaktor Forschung<text:tab/>7</text:a></text:p>
     <text:p text:style-name="P23"><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc2559_2106011183" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">6.4       Wachstumsfaktor Konstruktion<text:tab/>7</text:a></text:p>
     <text:p text:style-name="P22"><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc2561_2106011183" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">7       Kampfsystem<text:tab/>7</text:a></text:p>
     <text:p text:style-name="P23"><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc2563_2106011183" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">7.1       Gemeinsame Kampf Attribute<text:tab/>7</text:a></text:p>
     <text:p text:style-name="P24"><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc2565_2106011183" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">7.1.1          Treffgenauigkeit<text:tab/>7</text:a></text:p>
     <text:p text:style-name="P24"><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc2567_2106011183" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">7.1.2          Schildstärke<text:tab/>8</text:a></text:p>
     <text:p text:style-name="P24"><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc2569_2106011183" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">7.1.3          Angriffsstärke<text:tab/>8</text:a></text:p>
