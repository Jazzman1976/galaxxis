@{
    Layout = "_Game";
    ViewBag.Title = "Planet";
}
@model PlanetViewModel;

<div id="layer-background"></div>
<div id="layer-foreground"></div>
<div id="layer-inferface-background"></div>
<div id="layer-interface">
    <header>
        @await Component.InvokeAsync("ResourceBar", new { planet = Model.Planet })

        <h1>Planet: @Model.Planet.PlanetName</h1>
        
        <p>
            Du befindest dich auf einem Planeten.
        </p>
        
        <ul>
            <li>
                <!--back to system view -->
                <a asp-controller="galaxxissystem"
                   asp-action="Index"
                   asp-route-id="@Model.Planet.PlanetSystem.SystemId">
                   Zurück zum Sternensystem
               </a>
            </li>
        </ul>
    </header>

    <main>
        <h2>Planetarisches Kontrollzentrum</h2>
        <ul>
            <li>
                <!-- to ore mine -->
                <a asp-controller="oremine"
                   asp-action="Index"
                   asp-route-id="@Model.Planet.PlanetId">Zur Erzmine</a>
            </li>
            <li>
                <!-- to crystal mine -->
                <a asp-controller="crystalmine"
                   asp-action="Index"
                   asp-route-id="@Model.Planet.PlanetId">Zur Kristallmine</a>
            </li>
            <li>
                <!-- to power supply -->
                <a asp-controller="powersupply"
                   asp-action="Index"
                   asp-route-id="@Model.Planet.PlanetId">Zum Kraftwerk</a>
            </li>
        </ul>
    </main>
</div>
