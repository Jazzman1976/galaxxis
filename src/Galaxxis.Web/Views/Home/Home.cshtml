                    <tr><th>Energy</th><td>@oreMine.ConsumptionEnergyRate.GetValuePerTick()</td></tr>
                    <tr><th>Mana</th><td>@oreMine.ConsumptionManaRate.GetValuePerTick()</td></tr>
                    <tr><th>Antimatter</th><td>@oreMine.ConsupmtionAntimatter.GetValuePerTick()</td></tr>
                    <tr><th>Elementium</th><td>@oreMine.ConsumptionElementium.GetValuePerTick()</td></tr>
