
@{ 
    Layout = "_Layout";
    ViewBag.Title = "Home";
}


@model Galaxxis.Web.Models.Home.HomeViewModel 

<h1>Galaxxis</h1>

<h2>Home</h2>

<table style="margin-bottom: 1rem;">
    <tr>
        <th>UserId</th>
        <th>UserEmail</th>
        <th>UserFirstname</th>
        <th>UserLastname</th>
    </tr>

    @if (Model.User != null)
    {
    <tr>
        <td>@Model.User.UserId</td>
        <td>@Model.User.UserEmail</td>
        <td>@Model.User.UserFirstname</td>
        <td>@Model.User.UserLastname</td>
    </tr>
    }
</table>

@if(Model.User.Planet.Any())
{
    <table style="margin-bottom: 1rem;">
        <tr>
            <th>PlanetId</th>
            <th>PlanetName</th>
            <th>PlanetFields</th>            
            <th>SystemName</th>
            <th>GalaxyName</th>
            <th>Moons</th>
        </tr>

        @foreach(var planet in Model.User.Planet)
        {
            <tr>
                <td>@planet.PlanetId</td>
                <td>@planet.PlanetName</td>
                <td>@planet.PlanetFields</td>
                <td>@planet.PlanetSystem?.SystemName</td>
                <td>@planet.PlanetSystem?.SystemGalaxy?.GalaxyName</td>
                <td>
                    @if (planet.Moon.Any())
                    {
                    <table>
                        <tr>
                            <th>MoonId</th>
                            <th>MoonName</th>
                            <th>MoonFields</th>
                        </tr>
                        @foreach(var moon in planet.Moon)
                        {
                            <tr>
                                <td>@moon.MoonId</td>
                                <td>@moon.MoonName</td>
                                <td>@moon.MoonFields</td>
                            </tr>
                        }
                    </table>
                    }
                </td>
            </tr>
        }
    </table>
}
