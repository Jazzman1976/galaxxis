     <text:p text:style-name="P24"><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc2573_2106011183" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">7.1.5          Waffengattung<text:tab/>8</text:a></text:p>
