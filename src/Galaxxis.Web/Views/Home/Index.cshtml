
@{ 
    Layout = "_Layout";
    ViewBag.Title = "Index";
}

@model Galaxxis.Web.Models.Home.IndexViewModel 

<h1>Galaxxis</h1>

<table>
    <tr>
        <th>UserId</th>
        <th>UserEmail</th>
        <th>UserFirstname</th>
        <th>UserLastname</th>
    </tr>
    <tr>
        <td>@Model.User.UserId</td>
        <td>@Model.User.UserEmail</td>
        <td>@Model.User.UserFirstname</td>
        <td>@Model.User.UserLastname</td>
    </tr>
</table>