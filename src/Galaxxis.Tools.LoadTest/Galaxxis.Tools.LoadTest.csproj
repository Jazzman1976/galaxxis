<Project Sdk="Microsoft.NET.Sdk">

  <!-- Galaxxis.Tools.LoadTest: console tool that simulates many players and measures the engine. See README.md. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Galaxxis.Application\Galaxxis.Application.csproj" />
    <ProjectReference Include="..\Galaxxis.Engine\Galaxxis.Engine.csproj" />
    <ProjectReference Include="..\Galaxxis.Persistence\Galaxxis.Persistence.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Machine-specific secrets from the repository root (see appsettings.Local.json.template). -->
    <None Include="..\..\appsettings.Local.json" Link="appsettings.Local.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\appsettings.Local.json')" />
  </ItemGroup>

</Project>
