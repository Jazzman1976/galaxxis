                    <input type="hidden" name="planetId" value="@thePlanet.PlanetId" />
                    <input type="range" name="newValue" value="@(thePlanet.PlanetCrystalMineUsage * 100)" min="0" max="100" />
                    <br />
                    <input type="submit" value="Change Usage" />
                </form>
            </td>
            <td class="table-neutron-accelerator">
