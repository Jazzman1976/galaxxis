     </table:table-cell>
     <table:table-cell table:style-name="Table1.A2" office:value-type="string">
      <text:p text:style-name="P37">10000 = 6000 + (5-1)*1000</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table1.A2" office:value-type="string">
      <text:p text:style-name="P37">146 = 133 * 1,1</text:p>
     </table:table-cell>
    </table:table-row>
