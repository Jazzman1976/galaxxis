                    <tr><th>Mana</th><td>@mageAcademy.ConsumptionManaRate.GetValuePerTick()</td></tr>
                    <tr><th>Antimatter</th><td>@mageAcademy.ConsupmtionAntimatter.GetValuePerTick()</td></tr>
                    <tr><th>Elementium</th><td>@mageAcademy.ConsumptionElementium.GetValuePerTick()</td></tr>
                </table>
            </td>
            <td>
                <table>
                    <tr><th>Energy</th><td>@crystalMine.ConsumptionEnergyRate.GetValuePerTick()</td></tr>
                    <tr><th>Mana</th><td>@crystalMine.ConsumptionManaRate.GetValuePerTick()</td></tr>
                    <tr><th>Antimatter</th><td>@crystalMine.ConsupmtionAntimatter.GetValuePerTick()</td></tr>
                    <tr><th>Elementium</th><td>@crystalMine.ConsumptionElementium.GetValuePerTick()</td></tr>
                </table>
            </td>
            <td>
                <table>
                    <tr><th>Energy</th><td>@neutronAccelerator.ConsumptionEnergyRate.GetValuePerTick()</td></tr>
                    <tr><th>Mana</th><td>@neutronAccelerator.ConsumptionManaRate.GetValuePerTick()</td></tr>
                    <tr><th>Antimatter</th><td>@neutronAccelerator.ConsupmtionAntimatter.GetValuePerTick()</td></tr>
                    <tr><th>Elementium</th><td>@neutronAccelerator.ConsumptionElementium.GetValuePerTick()</td></tr>
                </table>
            </td>
            <td>
                <table>
                    <tr><th>Energy</th><td>@elementiumSynthesizer.ConsumptionEnergyRate.GetValuePerTick()</td></tr>
                    <tr><th>Mana</th><td>@elementiumSynthesizer.ConsumptionManaRate.GetValuePerTick()</td></tr>
                    <tr><th>Antimatter</th><td>@elementiumSynthesizer.ConsupmtionAntimatter.GetValuePerTick()</td></tr>
                    <tr><th>Elementium</th><td>@elementiumSynthesizer.ConsumptionElementium.GetValuePerTick()</td></tr>
                </table>
            </td>
        </tr>
        <tr>
            <th>Actions</th>
            <td class="table-ore">
                <table>
                    <tr><th colspan="2">Costs next level</th></tr>
                    <tr><th>Ore</th><td>@oreMine.BuildCosts[0]</td></tr>
                    <tr><th>Mana</th><td>@oreMine.BuildCosts[1]</td></tr>
                    <tr><th>Crystal</th><td>@oreMine.BuildCosts[2]</td></tr>
                    <tr><th>Elementium</th><td>@oreMine.BuildCosts[3]</td></tr>
                    <tr><th>Ticks</th><td>@oreMine.BuildCosts[4]</td></tr>
                </table>
                <form asp-controller="Home" asp-action="BuildOreMine" method="post">
                    <input type="hidden" name="planetId" value="@thePlanet.PlanetId" />
                    <input type="submit" value="Build" @(!oreMine.CanBuild ? "disabled" : "") />
                </form>
                <form asp-controller="Home" asp-action="ChangeOreMineUsage">
                    <input type="hidden" name="planetId" value="@thePlanet.PlanetId" />
                    <input type="range" name="newValue" value="@(thePlanet.PlanetOreMineUsage * 100)" min="0" max="100" />
                    <br />
                    <input type="submit" value="Change Usage" />
                </form>
            </td>
            <td class="table-power-supply">
                <table>
                    <tr><th colspan="2">Costs next level</th></tr>
                    <tr><th>Ore</th><td>@powerSupply.BuildCosts[0]</td></tr>
                    <tr><th>Mana</th><td>@powerSupply.BuildCosts[1]</td></tr>
                    <tr><th>Crystal</th><td>@powerSupply.BuildCosts[2]</td></tr>
                    <tr><th>Elementium</th><td>@powerSupply.BuildCosts[3]</td></tr>
                    <tr><th>Ticks</th><td>@powerSupply.BuildCosts[4]</td></tr>
                </table>
                <form asp-controller="Home" asp-action="BuildPowerSupply" method="post">
                    <input type="hidden" name="planetId" value="@thePlanet.PlanetId" />
                    <input type="submit" value="Build" @(!powerSupply.CanBuild ? "disabled" : "") />
                </form>
                <form asp-controller="Home" asp-action="ChangePowerSupplyUsage">
                    <input type="hidden" name="planetId" value="@thePlanet.PlanetId" />
                    <input type="range" name="newValue" value="@(thePlanet.PlanetPowerSupplyUsage * 100)" min="0" max="100" />
                    <br />
                    <input type="submit" value="Change Usage" />
                </form>
            </td>
            <td class="table-factory">
                <table>
                    <tr><th colspan="2">Costs next level</th></tr>
                    <tr><th>Ore</th><td>@factory.BuildCosts[0]</td></tr>
                    <tr><th>Mana</th><td>@factory.BuildCosts[1]</td></tr>
                    <tr><th>Crystal</th><td>@factory.BuildCosts[2]</td></tr>
                    <tr><th>Elementium</th><td>@factory.BuildCosts[3]</td></tr>
                    <tr><th>Ticks</th><td>@factory.BuildCosts[4]</td></tr>
                </table>
                <form asp-controller="Home" asp-action="BuildFactory" method="post">
                    <input type="hidden" name="planetId" value="@thePlanet.PlanetId" />
                    <input type="submit" value="Build" @(!factory.CanBuild ? "disabled" : "") />
                </form>
                <form asp-controller="Home" asp-action="ChangeFactoryUsage">
