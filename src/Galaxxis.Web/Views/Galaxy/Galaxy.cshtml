@using Galaxxis.Application.Map
@model GalaxyMapView
@{
    Layout = "_Game";
    ViewBag.Title = "Galaxie";
    ViewBag.Description = "Wähle ein Sternensystem";
}

<div id="layer-background" class="layer-background-galaxy"></div>
<div id="layer-foreground"></div>
<div id="layer-inferface-background"></div>
<div id="layer-interface">
    <main>
        <h1>@Model.Name Galaxie</h1>
        <p><a asp-controller="Universe" asp-action="Index" asp-route-id="@Model.UniverseId">Zurück</a> zum @Model.UniverseName Universum</p>
        <h2>Systeme in dieser Galaxie:</h2>
        <p>Systeme mit eigenen Planeten sind mit * markiert.</p>
        <form asp-controller="GalaxxisSystem" asp-action="Index" method="get">
            <div class="location-selection">
                <button type="button" class="location-selection__prev" data-for="system">&lt;</button>
                <div class="select-wrapper">
                    <select id="system" name="id">
                        @foreach (MapEntry system in Model.StarSystems)
                        {
                            <option value="@system.Id">@system.Name@(system.ContainsOwnPlanet ? " *" : "")</option>
                        }
                    </select>
                </div>
                <button type="button" class="location-selection__next" data-for="system">&gt;</button>
                <button type="submit" style="width:auto" class="button-link">GO</button>
            </div>
        </form>
    </main>
</div>
