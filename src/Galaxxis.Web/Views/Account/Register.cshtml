@model Galaxxis.Web.Views.Account.RegisterViewModel
@{
    Layout = "_Game";
    ViewBag.Title = "Registrieren";
}

<div id="layer-background"></div>
<div id="layer-foreground"></div>
<div id="layer-inferface-background"></div>
<div id="layer-interface">
    <header>
        <h1>Registrieren</h1>
        <div asp-validation-summary="All" class="message"></div>
    </header>
    <main>
        <p>
            Dein Passwort muss mindestens 6 Zeichen lang sein und mindestens einen Großbuchstaben,
            einen Kleinbuchstaben, eine Ziffer und ein Sonderzeichen enthalten.
        </p>
        <form id="form-register" asp-controller="Account" asp-action="Register" method="post">
            <label class="gx-form__label">
                <span>Benutzername:</span>
                <input class="gx-form__textbox" asp-for="UserName" autocomplete="username" />
            </label>
            <label class="gx-form__label">
                <span>Vorname:</span>
                <input class="gx-form__textbox" asp-for="FirstName" autocomplete="given-name" />
            </label>
            <label class="gx-form__label">
                <span>Nachname:</span>
                <input class="gx-form__textbox" asp-for="LastName" autocomplete="family-name" />
            </label>
            <label class="gx-form__label">
                <span>E-Mail:</span>
                <input class="gx-form__textbox" asp-for="Email" autocomplete="email" />
            </label>
            <label class="gx-form__label">
                <span>Passwort:</span>
                <input class="gx-form__textbox" asp-for="Password" autocomplete="new-password" />
            </label>
            <label class="gx-form__label">
                <span>Wiederholen:</span>
                <input class="gx-form__textbox" asp-for="ConfirmPassword" autocomplete="new-password" />
            </label>
            <span class="gx-form__label">
                <span></span>
                <input class="gx-form__textbox" type="submit" value="Registrieren" style="margin-right: 0.5rem" />
                <a class="button-link" asp-controller="Start" asp-action="Index">Zurück</a>
            </span>
        </form>
    </main>
</div>
