@using Galaxxis.Core.Extensions;
@using Galaxxis.Web.Views.Home

@{ 
    Layout = "_Layout";
    ViewBag.Title = "Home";
}

@model HomeViewModel 

<div style="margin-bottom: 1rem;">Game Ticks: @Model.User.Planet.First().PlanetSystem.SystemGalaxy.GalaxyUniverse.UniverseTicks</div>

<table style="margin-bottom: 1rem;">
    <tr>
        <th>UserId</th>
        <th>UserEmail</th>
        <th>UserFirstname</th>
        <th>UserLastname</th>
    </tr>

    @if (Model.User != null)
    {
    <tr>
        <td>@Model.User.UserId</td>
        <td>@Model.User.UserEmail</td>
        <td>@Model.User.UserFirstname</td>
        <td>@Model.User.UserLastname</td>
    </tr>
    }
</table>

@if(Model.User.Planet.Any())
{
    Galaxxis.Data.Models.Planet thePlanet = Model.User.Planet.First();

    <table style="margin-bottom: 1rem;">
        <tr>
            <th>PlanetId</th>
            <th>PlanetName</th>
            <th>PlanetFields</th>            
            <th>SystemName</th>
            <th>GalaxyName</th>
            <th>Moons</th>
        </tr>

        @foreach(var planet in Model.User.Planet)
        {
            <tr>
                <td>@planet.PlanetId</td>
                <td>@planet.PlanetName</td>
                <td>@planet.PlanetFields</td>
                <td>@planet.PlanetSystem?.SystemName</td>
                <td>@planet.PlanetSystem?.SystemGalaxy?.GalaxyName</td>
                <td>
                    @if (planet.Moon.Any())
                    {
                    <table>
                        <tr>
                            <th>MoonId</th>
                            <th>MoonName</th>
                            <th>MoonFields</th>
                        </tr>
                        @foreach(var moon in planet.Moon)
                        {
                            <tr>
                                <td>@moon.MoonId</td>
                                <td>@moon.MoonName</td>
                                <td>@moon.MoonFields</td>
                            </tr>
                        }
                    </table>
                    }
                </td>
            </tr>
        }
    </table>

    <table style="margin-bottom: 1rem;">
        <tr>
            <th></th>
            <th>Ore</th>
            <th>Energy</th>            
            <th>Tools</th>
            <th>Mana</th>
            <th>Crystals</th>
            <th>Antimatter</th>
            <th>Elementium</th>
        </tr>
        <tr>
            <th>Level</th>
            <td>@thePlanet.PlanetOreMine</td>
            <td>@thePlanet.PlanetPowerSupply</td>
            <td>@thePlanet.PlanetFactory</td>
            <td>@thePlanet.PlanetMageAcademy</td>
            <td>@thePlanet.PlanetCrystalMine</td>
            <td>@thePlanet.PlanetNeutronAccelerator</td>
            <td>@thePlanet.PlanetElementiumSynthesizer</td>
        </tr>
        <tr>
            <th>Stock</th>
            <td>@thePlanet.GetStockOre()</td>
            <td>@thePlanet.GetStockEnergy()</td>
            <td>@thePlanet.GetStockTools()</td>
            <td>@thePlanet.PlanetMana</td>
            <td>@thePlanet.PlanetCrystals</td>
            <td>@thePlanet.PlanetAntimatter</td>
            <td>@thePlanet.PlanetElementium</td>
        </tr>
        <tr>
            <th>Income/Day (86.400 ticks)</th>
            <td>@thePlanet.GetIncomeOrePerDay()</td>
            <td>@thePlanet.GetIncomeEnergyPerDay()</td>
            <td>@thePlanet.GetIncomeToolsPerDay()</td>
            <td></td>
            <td></td>
            <td></td>
            <td></td>
        </tr>
        <tr>
            <th>Income/Tick (@Model.User.Planet.First().PlanetSystem.SystemGalaxy.GalaxyUniverse.UniverseTimePerTick ms)</th>
            <td>@thePlanet.GetIncomeOrePerTick()</td>
            <td>@thePlanet.GetIncomeEnergyPerTick()</td>
            <td>@thePlanet.GetIncomeToolsPerTick()</td>
            <td></td>
            <td></td>
            <td></td>
            <td></td>
        </tr>        
    </table>
}
