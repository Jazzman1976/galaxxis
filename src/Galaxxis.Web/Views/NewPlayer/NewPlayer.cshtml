@{
    Layout = "_Layout";
    ViewBag.Title = "New Player";
}
@using Galaxxis.Data.Models;
@model NewPlayerViewModel;

<h1>New Player</h1>

@if(!Model.HasAnyPlanet) {
    <form asp-action="Spawn" method="post">
        <div class="form-group">
            <label asp-for="UniverseId"></label>
            <select asp-for="UniverseId" class="form-control">
                <option value="">Select a Universe</option>
                @foreach (Universe universe in Model.Universes)
                {
                    <option value="@universe.UniverseId">@universe.UniverseName</option>
                }
            </select>
        </div>
        
        <button type="submit" class="btn btn-primary">Spawn in Universe</button>
        </form>
    }

else
{
    <p>You have spawned on a planet</p>
    <a href="/home">go to home</a>
}
