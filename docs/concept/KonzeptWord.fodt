     <text:p text:style-name="P23"><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc2545_2106011183" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">5.4          Goblins<text:tab/>6</text:a></text:p>
     <text:p text:style-name="P23"><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc2547_2106011183" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">5.5          Trolle<text:tab/>6</text:a></text:p>
