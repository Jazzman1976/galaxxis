@using Core.Classes.Buildings.RessourceBuildings;
@using Core.Extensions.PlanetExtensions;
@model Galaxxis.Data.Models.Planet;

@{
    OreMine oreMine = Model.GetOreMine();
    PowerSupply powerSupply = Model.GetPowerSupply();
    Factory factory = Model.GetFactory();
    MageAcademy mageAcademy = Model.GetMageAcademy();
    CrystalMine crystalMine = Model.GetCrystalMine();
    NeutronAccelerator neutronAccelerator = Model.GetNeutronAccelerator();
    ElementiumSynthesizer elementiumSynthesizer = Model.GetElementiumSynthesizer();

    long ticksGone = Core.Engine.Ticker.Instance.Ticks - Model.PlanetDataTick;
    long timePerTick = Model.PlanetSystem.SystemGalaxy.GalaxyUniverse.UniverseTimePerTick;

    double currentOre = Model.PlanetOre + oreMine.AmountPerTick * ticksGone;
    double currentEnergy = Model.PlanetEnergy + powerSupply.AmountPerTick * ticksGone;
    double currentTools = Model.PlanetTools + factory.AmountPerTick * ticksGone;
    double currentMana = Model.PlanetMana + mageAcademy.AmountPerTick * ticksGone;
    double currentCrystals = Model.PlanetCrystals + crystalMine.AmountPerTick * ticksGone;
    double currentAntimatter = Model.PlanetAntimatter + neutronAccelerator.AmountPerTick * ticksGone;
    double currentElementium = Model.PlanetElementium + elementiumSynthesizer.AmountPerTick * ticksGone;
}

<div class="gx-resource-bar" data-instance-id="@Guid.NewGuid()">
    <div class="gx-resource-bar__item gx-resource-bar__item--ore">
        <div class="gx-resource-bar__name">Erz</div>
        <div class="gx-resource-bar__value" data-raw="@currentOre">@Math.Floor(currentOre)</div>
    </div>

    <div class="gx-resource-bar__item gx-resource-bar__item--energy">
        <div class="gx-resource-bar__name">Energie</div>
        <div class="gx-resource-bar__value" data-raw="@currentEnergy">@Math.Floor(currentEnergy)</div>
    </div>

    <div class="gx-resource-bar__item gx-resource-bar__item--tools">
        <div class="gx-resource-bar__name">Werkzeuge</div>
        <div class="gx-resource-bar__value" data-raw="@currentTools">@Math.Floor(currentTools)</div>
    </div>

    <div class="gx-resource-bar__item gx-resource-bar__item--mana">
        <div class="gx-resource-bar__name">Mana</div>
        <div class="gx-resource-bar__value" data-raw="@currentMana">@Math.Floor(currentMana)</div>
    </div>

    <div class="gx-resource-bar__item gx-resource-bar__item--crystals">
        <div class="gx-resource-bar__name">Kristalle</div>
        <div class="gx-resource-bar__value" data-raw="@currentCrystals">@Math.Floor(currentCrystals)</div>
    </div>

    <div class="gx-resource-bar__item gx-resource-bar__item--antimatter">
        <div class="gx-resource-bar__name">Antimaterie</div>
        <div class="gx-resource-bar__value" data-raw="@currentAntimatter">@Math.Floor(currentAntimatter)</div>
    </div>

    <div class="gx-resource-bar__item gx-resource-bar__item--elementium">
        <div class="gx-resource-bar__name">Elementium</div>
        <div class="gx-resource-bar__value" data-raw="@currentElementium">@Math.Floor(currentElementium)</div>
    </div>

    <script>
        window.galaxxis = window.galaxxis || {};
        window.galaxxis.resourceBar = window.galaxxis.resourceBar || {};
        
        window.galaxxis.resourceBar.initBar = (amountPerTick, itemClass) => {
            const el = document.querySelector(`.gx-resource-bar ${itemClass} .gx-resource-bar__value`);
            if (!el) return;

            let val = +el.dataset.raw.replace(',', '.') || 0;
            const perTick = +amountPerTick.toString().replace(',', '.') || 0;
            let shown = Math.floor(val);

            setInterval(() => {
                val += perTick;
                const v = Math.floor(val);
                if (v !== shown) {
                shown = v;
                el.textContent = v;
                }
                el.dataset.raw = val.toString().replace('.', ',');
            }, @timePerTick);
        };

        window.galaxxis.resourceBar.setup = () => {
            window.galaxxis.resourceBar.initBar('@oreMine.AmountPerTick', '.gx-resource-bar__item--ore');
            window.galaxxis.resourceBar.initBar('@powerSupply.AmountPerTick', '.gx-resource-bar__item--energy');
            window.galaxxis.resourceBar.initBar('@factory.AmountPerTick', '.gx-resource-bar__item--tools');
            window.galaxxis.resourceBar.initBar('@mageAcademy.AmountPerTick', '.gx-resource-bar__item--mana');
            window.galaxxis.resourceBar.initBar('@crystalMine.AmountPerTick', '.gx-resource-bar__item--crystals');
            window.galaxxis.resourceBar.initBar('@neutronAccelerator.AmountPerTick', '.gx-resource-bar__item--antimatter');
            window.galaxxis.resourceBar.initBar('@elementiumSynthesizer.AmountPerTick', '.gx-resource-bar__item--elementium');
        };

        (() => {
          addEventListener('DOMContentLoaded', window.galaxxis.resourceBar.setup);
          addEventListener('pageshow', e => e.persisted && window.galaxxis.resourceBar.setup());
        })();
    </script>

    <style type="text/css">
        .gx-resource-bar { display: flex; flex-wrap: wrap; margin-bottom: calc(0.625rem + 1px); }
            .gx-resource-bar__item { border: 1px solid #49fb35; flex: 1 0 0; margin-bottom: -1px; }
                .gx-resource-bar__name, 
                .gx-resource-bar__value { padding: 0.5rem 0.75rem; text-align: right; }
                .gx-resource-bar__name { border-bottom: 1px solid #49fb35; }
    </style>
</div>
