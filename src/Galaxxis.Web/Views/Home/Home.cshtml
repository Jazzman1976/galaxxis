@using Galaxxis.Core.Extensions.PlanetExtensions
@using Galaxxis.Core.Extensions
@using Galaxxis.Data.Models
@using Galaxxis.Core.Classes.Buildings.RessourceBuildings
@using Galaxxis.Core.Classes.Buildings.ProducingBuildings
@using Galaxxis.Core.Business.Helper;
@using Galaxxis.Core.Business.Provider;

@model HomeViewModel

@{
    Layout = "_Layout";
    ViewBag.Title = "Home";

    // use first as demo planet in this homepage
    Planet thePlanet = Model.User.Planet.First();
    Data.Models.System theSystem = SystemProvider.GetSystem(thePlanet.PlanetSystemId);

    // assure planet and user
    if (thePlanet == null || Model.User == null)
    {
        return;
    }

    // update ressources on planet
    thePlanet.UpdateRessources();
    thePlanet.ClearCache();

    // init markup vars
    OreMine oreMine = thePlanet.GetOreMine();
    MageAcademy mageAcademy = thePlanet.GetMageAcademy();
    PowerSupply powerSupply = thePlanet.GetPowerSupply();
    Factory factory = thePlanet.GetFactory();
    CrystalMine crystalMine = thePlanet.GetCrystalMine();
    NeutronAccelerator neutronAccelerator = thePlanet.GetNeutronAccelerator();
    ElementiumSynthesizer elementiumSynthesizer = thePlanet.GetElementiumSynthesizer();
    Shipyard shipyard = thePlanet.GetShipyard();
    double universeTicks = Model.Ticker.Ticks;
    List<Ship> planetShips = Model.User.Ship.Where(ship => ship.ShipPlanetId.Equals(thePlanet.PlanetId)).ToList();
}

<style>
    table {
        border-spacing: 0;
        border-collapse: collapse;
    }

    td, th {
        font-size: .8rem;
        padding: 5px 10px;
        border-width: 1px;
        border-style: solid;
        border-color: blueviolet;
    }

    th {
        text-align: center;
        vertical-align: middle;
    }

    td {
        vertical-align: top;
    }

    form + form {
        margin-top: 10px;
    }
</style>

<div>Game Ticks: @universeTicks</div>
<div style="margin-bottom: 1rem;">Building in progress?: @(thePlanet.IsBuilding() ? "yes" : "no")</div>

<div id="user-panel" style="margin-bottom: 1rem;">
    <table>
        <tr>
            <th>UserId</th>
            <th>UserEmail</th>
            <th>UserFirstname</th>
            <th>UserLastname</th>
            <th>Race</th>
        </tr>

        <tr>
            <td>@Model.User.UserId</td>
            <td>@Model.User.UserEmail</td>
            <td>@Model.User.UserFirstname</td>
            <td>@Model.User.UserLastname</td>
            <td>@Model.User.UserRace</td>
        </tr>
    </table>
</div>

<div id="planet-panel" style="margin-bottom: 1rem;">
    <table>
        <tr>
            <th>PlanetId</th>
            <th>PlanetName</th>
            <th>PlanetFields</th>
            <th>SystemName</th>
            <th>GalaxyName</th>
            <th>Moons</th>
        </tr>

        @foreach (var planet in Model.User.Planet)
        {
            <tr>
                <td>@planet.PlanetId</td>
                <td>@planet.PlanetName</td>
                <td>@planet.PlanetFields</td>
                <td>@planet.PlanetSystem?.SystemName</td>
                <td>@planet.PlanetSystem?.SystemGalaxy?.GalaxyName</td>
                <td>
                    @if (planet.Moon.Any())
                    {
                        <table>
                            <tr>
                                <th>MoonId</th>
                                <th>MoonName</th>
                                <th>MoonFields</th>
                            </tr>
                            @foreach (var moon in planet.Moon)
                            {
                                <tr>
                                    <td>@moon.MoonId</td>
                                    <td>@moon.MoonName</td>
                                    <td>@moon.MoonFields</td>
                                </tr>
                            }
                        </table>
                    }
                </td>
            </tr>
        }
    </table>
</div>

