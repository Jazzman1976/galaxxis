{
  // Settings for development only (ASPNETCORE_ENVIRONMENT = Development, used by "dotnet run" and the VS Code debug
  // configuration). They override appsettings.json. No secrets here: those belong into appsettings.Local.json.
  "Logging": {
    "LogLevel": {
      // The engine's tick log: one line per tick of every running universe, one line per handled event and one per
      // planet whose resources were settled. Set to "Information" to switch it off. See src/Galaxxis.Engine/README.md.
      "Galaxxis.Engine.TickLog": "Debug"
    },

    // One line per log entry with a timestamp, so the tick log reads like a running protocol.
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "TimestampFormat": "HH:mm:ss.fff "
      }
    },

    // The "Debug" provider writes to the attached debugger. In the VS Code Debug Console, which already shows the
    // console output, every line would appear twice, so it is switched off.
    "Debug": {
      "LogLevel": {
        "Default": "None"
      }
    }
  }
}
