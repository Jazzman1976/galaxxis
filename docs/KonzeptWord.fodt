     </table:table-cell>
     <table:table-cell table:style-name="Table15.B2" office:value-type="string">
      <text:p text:style-name="Text_20_Body.MsoNormal">AK Zwerg 3, <text:span text:style-name="T11">TG=55%</text:span>, SS=20%, SP=50 <text:span text:style-name="T7">(6)</text:span></text:p>
