@using Galaxxis.Application.Map
@model UniverseMapView
@{
    Layout = "_Game";
    ViewBag.Title = "Universum";
    ViewBag.Description = "Wähle eine Galaxie";
}

<div id="layer-background" class="layer-background-universe"></div>
<div id="layer-foreground"></div>
<div id="layer-inferface-background"></div>
<div id="layer-interface">
    <main>
        <h1>@Model.Name Universum</h1>
        <h2>Galaxien in diesem Universum:</h2>
        <p>Galaxien mit eigenen Planeten sind mit * markiert.</p>
        @* A GET form: choosing a galaxy only navigates, it changes nothing. *@
        <form asp-controller="Galaxy" asp-action="Index" method="get">
            <div class="location-selection">
                <button type="button" class="location-selection__prev" data-for="galaxy">&lt;</button>
                <div class="select-wrapper">
                    <select id="galaxy" name="id">
                        @foreach (MapEntry galaxy in Model.Galaxies)
                        {
                            <option value="@galaxy.Id">@galaxy.Name@(galaxy.ContainsOwnPlanet ? " *" : "")</option>
                        }
                    </select>
                </div>
                <button type="button" class="location-selection__next" data-for="galaxy">&gt;</button>
                <button type="submit" style="width:auto" class="button-link">GO</button>
            </div>
        </form>
    </main>
</div>
