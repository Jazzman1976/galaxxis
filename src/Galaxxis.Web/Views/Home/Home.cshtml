
@{ 
    Layout = "_Layout";
    ViewBag.Title = "Home";
}


@model Galaxxis.Web.Models.Home.HomeViewModel 

<h1>Galaxxis</h1>

<h2>Home</h2>

<table style="margin-bottom: 1rem;">
    <tr>
        <th>UserId</th>
        <th>UserEmail</th>
        <th>UserFirstname</th>
        <th>UserLastname</th>
    </tr>

    @if (Model.User != null)
    {
    <tr>
        <td>@Model.User.UserId</td>
        <td>@Model.User.UserEmail</td>
        <td>@Model.User.UserFirstname</td>
        <td>@Model.User.UserLastname</td>
    </tr>
    }
</table>

@if(Model.User.PlanetToUser.Any())
{
    <table style="margin-bottom: 1rem;">
        <tr>
            <th>PlanetId</th>
            <th>PlanetName</th>
            <th>PlanetFields</th>
            <th>SystemName</th>
            <th>GalaxyName</th>
        </tr>

        @foreach(var p2u in Model.User.PlanetToUser)
        {
            <tr>
                <td>@p2u.Planet.PlanetId</td>
                <td>@p2u.Planet.PlanetName</td>
                <td>@p2u.Planet.PlanetFields</td>
                <td>@p2u.Planet.PlanetToSystem.First().System.SystemName</td>
                <td>@p2u.Planet.PlanetToSystem.First().System.SystemToGalaxy.First().Galaxy.GalaxyName</td>
            </tr>
        }
    </table>
}
