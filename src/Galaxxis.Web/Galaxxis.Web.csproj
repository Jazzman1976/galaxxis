<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Galaxxis.Web: the browser game (ASP.NET Core MVC). Hosts the engine as a background service for now.
    Controllers only call Application services; no game logic lives here. See README.md.
  -->

  <ItemGroup>
    <ProjectReference Include="..\Galaxxis.Application\Galaxxis.Application.csproj" />
    <ProjectReference Include="..\Galaxxis.Engine\Galaxxis.Engine.csproj" />
    <ProjectReference Include="..\Galaxxis.Persistence\Galaxxis.Persistence.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Machine-specific secrets from the repository root (see appsettings.Local.json.template). Never published. -->
    <None Include="..\..\appsettings.Local.json" Link="appsettings.Local.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" Condition="Exists('..\..\appsettings.Local.json')" />
  </ItemGroup>

  <ItemGroup>
    <!-- The front-end build (gulp, SCSS sources) is not part of the published site. -->
    <Content Update="package.json;package-lock.json" CopyToPublishDirectory="Never" />
    <Content Update="wwwroot\styles\src\**;wwwroot\scripts\src\**" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
