     <table:table-cell table:style-name="Table14.B2" office:value-type="string">
      <text:p text:style-name="P31">AK Ork 1, TG=45%, <text:span text:style-name="T15">SS=10%</text:span>, SP=20 <text:span text:style-name="T8">(4)</text:span></text:p>
