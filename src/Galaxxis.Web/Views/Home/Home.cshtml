                    <tr><th>Antimatter</th><td>@powerSupply.ConsupmtionAntimatter.GetValuePerTick()</td></tr>
                    <tr><th>Elementium</th><td>@powerSupply.ConsumptionElementium.GetValuePerTick()</td></tr>
                </table>
            </td>
            <td>
                <table>
                    <tr><th>Energy</th><td>@factory.ConsumptionEnergyRate.GetValuePerTick()</td></tr>
                    <tr><th>Mana</th><td>@factory.ConsumptionManaRate.GetValuePerTick()</td></tr>
                    <tr><th>Antimatter</th><td>@factory.ConsupmtionAntimatter.GetValuePerTick()</td></tr>
                    <tr><th>Elementium</th><td>@factory.ConsumptionElementium.GetValuePerTick()</td></tr>
